              ]
            }
          }
        },
        {
          "name": "Salary Distribution",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/dashboard/salary-distribution",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "dashboard",
                "salary-distribution"
              ]
            }
          }
        }
      ]
    }
  ]
}
